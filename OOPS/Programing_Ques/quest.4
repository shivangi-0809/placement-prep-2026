interface A {
    default void show() {
        System.out.println("A");
    }
}

interface B {
    default void show() {
        System.out.println("B");
    }
}

class Test implements A, B {

    public void show() {
        A.super.show();
        B.super.show();
    }
}

public class Main {
    public static void main(String[] args) {
        new Test().show();
    }
}


=====================output=================
A
B
